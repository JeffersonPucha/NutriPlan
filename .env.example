# Variables exclusivas del servidor. No usar el prefijo NEXT_PUBLIC_.
# DATABASE_URL es necesaria para los catálogos API y /api/health.
DATABASE_URL="postgresql://nutriplan:change-me@localhost:5432/nutriplan?schema=public"
# Opcional: utiliza el id del usuario DEMO creado por el seed.
NUTRIPLAN_DEMO_USER_ID="demo_nutriplan_user"
OPENAI_API_KEY=""
