generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  BORRADOR
  ACTIVO
  COMPLETADO
  ARCHIVADO
}

enum MealType {
  DESAYUNO
  ALMUERZO
  CENA
  MERIENDA
}

// StoreProduct.precio corresponde a UNA unidad base del producto.
enum ProductUnit {
  KG
  L
  UNIDAD
}

model User {
  id                  String               @id @default(cuid())
  nombre              String               @default("") @map("displayName")
  email               String               @unique
  preferences         UserPreference[]
  allergies           UserAllergy[]
  excludedIngredients ExcludedIngredient[]
  plans               MealPlan[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Preference {
  id      String             @id @default(cuid())
  nombre  String             @unique
  slug    String             @unique
  users   UserPreference[]
  recipes RecipePreference[]
  plans   PlanPreference[]
}

model Allergy {
  id      String          @id @default(cuid())
  nombre  String          @unique
  slug    String          @unique
  users   UserAllergy[]
  recipes RecipeAllergy[]
  plans   PlanAllergy[]
}

model UserPreference {
  userId       String
  preferenceId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  preference   Preference @relation(fields: [preferenceId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@id([userId, preferenceId])
  @@index([preferenceId])
}

model UserAllergy {
  userId    String
  allergyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy  @relation(fields: [allergyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, allergyId])
  @@index([allergyId])
}

model ExcludedIngredient {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  nombre    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, nombre])
  @@index([productId])
}

model Store {
  id       String         @id @default(cuid())
  nombre   String
  slug     String         @unique
  activo   Boolean        @default(true)
  products StoreProduct[]
  plans    MealPlan[]
}

model Product {
  id                  String               @id @default(cuid())
  nombre              String               @unique
  categoria           String
  unidad              ProductUnit
  activo              Boolean              @default(true)
  stores              StoreProduct[]
  recipeIngredients   RecipeIngredient[]
  shoppingItems       ShoppingItem[]
  excludedIngredients ExcludedIngredient[]

  @@index([categoria, activo])
}

model StoreProduct {
  id             String   @id @default(cuid())
  storeId        String
  productId      String
  precio         Decimal  @db.Decimal(12, 2)
  disponibilidad Boolean  @default(true)
  actualizadoEn  DateTime @default(now()) @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, productId])
  @@index([productId])
}

model MealPlan {
  id            String                   @id @default(cuid())
  userId        String
  storeId       String
  presupuesto   Decimal                  @db.Decimal(10, 2)
  dias          Int
  personas      Int
  estado        PlanStatus               @default(BORRADOR)
  costoEstimado Decimal                  @map("total") @db.Decimal(10, 2)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  meals         PlanMeal[]
  shoppingList  ShoppingList?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  requestKey    String?                  @unique
  preferences   PlanPreference[]
  allergies     PlanAllergy[]
  exclusions    PlanExcludedIngredient[]

  @@index([userId, createdAt])
  @@index([storeId])
}

model PlanMeal {
  id            String   @id @default(cuid())
  planId        String
  recipeId      String
  dia           Int      @map("dayIndex")
  tipo          MealType @default(ALMUERZO)
  orden         Int      @default(0)
  preparado     Boolean  @default(false) @map("cooked")
  costoEstimado Decimal  @default(0) @db.Decimal(12, 2)
  plan          MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@unique([planId, dia, tipo, orden])
  @@index([recipeId])
}

// Cada plan conserva sus restricciones aunque cambie el perfil del usuario.
model PlanPreference {
  planId       String
  preferenceId String
  plan         MealPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  preference   Preference @relation(fields: [preferenceId], references: [id], onDelete: Restrict)

  @@id([planId, preferenceId])
  @@index([preferenceId])
}

model PlanAllergy {
  planId    String
  allergyId String
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  allergy   Allergy  @relation(fields: [allergyId], references: [id], onDelete: Restrict)

  @@id([planId, allergyId])
  @@index([allergyId])
}

model PlanExcludedIngredient {
  id     String   @id @default(cuid())
  planId String
  nombre String
  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, nombre])
}

model Recipe {
  id                String             @id @default(cuid())
  nombre            String             @map("name")
  descripcion       String             @default("")
  tiempoPreparacion Int                @map("minutes")
  instrucciones     String[]           @map("steps")
  porciones         Int                @default(1)
  imagen            String?
  costoEstimado     Decimal?           @db.Decimal(10, 2)
  ingredients       RecipeIngredient[]
  preferences       RecipePreference[]
  allergies         RecipeAllergy[]
  meals             PlanMeal[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
}

model RecipeIngredient {
  id        String      @id @default(cuid())
  recipeId  String
  productId String
  cantidad  Decimal     @db.Decimal(12, 3)
  unidad    ProductUnit
  recipe    Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([recipeId, productId])
  @@index([productId])
}

model RecipePreference {
  recipeId     String
  preferenceId String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  preference   Preference @relation(fields: [preferenceId], references: [id], onDelete: Restrict)

  @@id([recipeId, preferenceId])
  @@index([preferenceId])
}

model RecipeAllergy {
  recipeId  String
  allergyId String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Restrict)

  @@id([recipeId, allergyId])
  @@index([allergyId])
}

model ShoppingList {
  id        String         @id @default(cuid())
  planId    String         @unique
  plan      MealPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ShoppingItem {
  id             String       @id @default(cuid())
  shoppingListId String
  productId      String
  cantidad       Decimal      @map("quantity") @db.Decimal(12, 3)
  unidad         ProductUnit
  precioEstimado Decimal      @map("cost") @db.Decimal(12, 2)
  comprado       Boolean      @default(false) @map("checked")
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shoppingListId, productId])
  @@index([productId])
}
